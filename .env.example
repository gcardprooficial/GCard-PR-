# Supabase (server)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."   # server only, never exposed to the client

# Supabase (client build-time, injected by Vite)
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Google Places API (New) — https://console.cloud.google.com → APIs & Services
# Enable "Places API (New)". Restrict the key to that API. Server-side only.
GOOGLE_MAPS_API_KEY="AIza..."

# Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""

# Transactional email
# RESEND_API_KEY=""
# RESEND_FROM="GCard-PRÓ <noreply@gcardpro.com.br>"
# RESEND_FROM_EMAIL="GCard-PRÓ <noreply@gcardpro.com.br>" # compatibilidade
# PUBLIC_APP_URL="https://www.gcardpro.com.br"
# ADMIN_NOTIFY_EMAIL="voce@gcardpro.com.br" # avisa se o link de pagamento falhar depois de 3 tentativas

# Analytics e Search Console (opcionais; somente identificadores públicos)
# VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# VITE_GTM_ID="GTM-XXXXXXX"
# VITE_GOOGLE_SITE_VERIFICATION="..."

# Melhor Envio (OAuth) — Configurações → Aplicativos, em melhorenvio.com.br
# MELHORENVIO_CLIENT_ID=""
# MELHORENVIO_CLIENT_SECRET=""
# MELHORENVIO_ENV="sandbox" # ou "production"

# Chat de suporte (Tawk.to) — pegue o ID em dashboard.tawk.to > Administration > Channels > Chat Widget
# Formato: "<propertyId>/<widgetId>", ex: "64abc123.../1h8xyz"
# VITE_TAWKTO_ID="propertyId/widgetId"

# WhatsApp (API oficial da Meta) — passo a passo em docs/WHATSAPP-ZAPI.md. Todas server-only.
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_APP_SECRET=""
# WHATSAPP_VERIFY_TOKEN=""
# IA do atendimento (Claude)
# ANTHROPIC_API_KEY=""

# WhatsApp via Z-API (padrao) -- passo a passo em docs/WHATSAPP-ZAPI.md. Todas server-only.
# ZAPI_INSTANCE_ID=""
# ZAPI_TOKEN=""
# ZAPI_CLIENT_TOKEN=""
# ZAPI_WEBHOOK_SECRET="" # senha longa; vai na URL do webhook (?secret=)
# IA do atendimento: use UMA das duas (se as duas existirem, usa a Anthropic)
# GEMINI_API_KEY="" # Google AI Studio (aistudio.google.com/apikey); modelo padrao gemini-2.5-flash, troque com GEMINI_MODEL
# ZAPI_NATIVE_BUTTONS="true" # opcional: botoes nativos na Z-API (instavel); padrao = lista numerada
# WA_NOTIFY_DAILY_CAP="80" # opcional: maximo de avisos de pedido por WhatsApp por dia

# InfinitePay (checkout alternativo ao Mercado Pago)
# INFINITEPAY_HANDLE="leonardo-marusso"
# INFINITEPAY_WEBHOOK_SECRET=""   # string aleatória longa, vai na URL do webhook
