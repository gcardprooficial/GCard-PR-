# Supabase (server)
SUPABASE_URL="https://<project>.supabase.co"
SUPABASE_PROJECT_ID="<project-ref>"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."   # server only, never exposed to the client

# Supabase (client build-time, injected by Vite)
VITE_SUPABASE_URL="https://<project>.supabase.co"
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Google Places API (New) — https://console.cloud.google.com → APIs & Services
# Enable "Places API (New)". Restrict the key to that API. Server-side only.
GOOGLE_MAPS_API_KEY="AIza..."

# Mercado Pago
# MERCADOPAGO_ACCESS_TOKEN=""
# MERCADOPAGO_WEBHOOK_SECRET=""

# Transactional email
# RESEND_API_KEY=""
# RESEND_FROM="GCard-PRÓ <noreply@gcardpro.com.br>"
# RESEND_FROM_EMAIL="GCard-PRÓ <noreply@gcardpro.com.br>" # compatibilidade
# PUBLIC_APP_URL="https://www.gcardpro.com.br"
# ADMIN_NOTIFY_EMAIL="voce@gcardpro.com.br" # avisa se o link de pagamento falhar depois de 3 tentativas

# Analytics e Search Console (opcionais; somente identificadores públicos)
# VITE_GA4_MEASUREMENT_ID="G-XXXXXXXXXX"
# VITE_GTM_ID="GTM-XXXXXXX"
# VITE_GOOGLE_SITE_VERIFICATION="..."

# Melhor Envio (OAuth) — Configurações → Aplicativos, em melhorenvio.com.br
# MELHORENVIO_CLIENT_ID=""
# MELHORENVIO_CLIENT_SECRET=""
# MELHORENVIO_ENV="sandbox" # ou "production"

# Chat de suporte (Tawk.to) — pegue o ID em dashboard.tawk.to > Administration > Channels > Chat Widget
# Formato: "<propertyId>/<widgetId>", ex: "64abc123.../1h8xyz"
# VITE_TAWKTO_ID="propertyId/widgetId"
